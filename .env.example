# DigiVirasat 2.0 - Environment Configuration
# Copy this file to .env and configure your AWS API Gateway endpoint URL.

# Base URL for AWS API Gateway (e.g., https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com)
VITE_API_BASE_URL=

# AWS Region
VITE_AWS_REGION=ap-south-1

# IMPORTANT SECURITY NOTE:
# NEVER put AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or AWS_SESSION_TOKEN here.
# The frontend uses API Gateway endpoints with presigned S3 URLs to ensure maximum security.
